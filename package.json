{
  "name": "decky-navidrome-player",
  "version": "0.1.1",
  "description": "Navidrome music streaming, offline cache and player for Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abduznik/decky-navidrome-player.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "navidrome",
    "subsonic",
    "music",
    "steam-deck"
  ],
  "author": "abduznik",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/abduznik/decky-navidrome-player/issues"
  },
  "homepage": "https://github.com/abduznik/decky-navidrome-player#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
